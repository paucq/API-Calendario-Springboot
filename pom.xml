<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>calendario</groupId>
    <artifactId>apicalendario</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>apicalendario</name>
    <description>API Calendario - Spring Boot, PostgreSQL y arquitectura Onion</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <modules>
        <module>dominio</module>
        <module>core</module>
        <module>aplicacion</module>
        <module>infraestructura</module>
        <module>presentacion</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>calendario</groupId>
                <artifactId>dominio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>calendario</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>calendario</groupId>
                <artifactId>aplicacion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>calendario</groupId>
                <artifactId>infraestructura</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
